{
  "name": "agy-route-disable-websearch",
  "version": "0.5.0",
  "description": "Hard-deny native WebSearch tool in permissions so all web searches go through agy-route skills / slash commands.",
  "author": {
    "name": "agy-route contributors",
    "url": "https://github.com/hsuanguo/agy-route"
  },
  "license": "MIT",
  "homepage": "https://github.com/hsuanguo/agy-route",
  "keywords": [
    "agy",
    "antigravity",
    "gemini",
    "web-search",
    "deny-websearch",
    "claude-code-plugin"
  ],
  "permissions": {
    "allow": [
      "Bash(agy-route search *)",
      "Bash(agy-route research *)"
    ],
    "deny": [
      "WebSearch"
    ]
  }
}
